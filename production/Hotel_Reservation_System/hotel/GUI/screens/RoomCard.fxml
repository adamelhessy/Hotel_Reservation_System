<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.text.Font?>

<HBox minHeight="200.0" prefHeight="220.0" prefWidth="650.0" spacing="15.0"
      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
      styleClass="card" stylesheets="@../styles/theme.css"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hotel.GUI.controllers.RoomViewController">
    <children>
        <StackPane minWidth="200.0" prefWidth="200.0" style="-fx-background-color: #eee; -fx-background-radius: 12 0 0 12;">
            <children>
                <ImageView fx:id="roomImage" fitHeight="220.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="false" />
                <Label fx:id="ratingLabel" style="-fx-background-color: rgba(255,255,255,0.8); -fx-background-radius: 20; -fx-padding: 2 8;" text="⭐ 4.5" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin>
                        <Insets right="8.0" top="8.0" />
                    </StackPane.margin>
                </Label>
            </children>
        </StackPane>
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="15.0" left="10.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="roomTitleLabel" text="Room Name" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <VBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="priceLabel" text="Price $" textFill="#2d6a4f">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                                <Label text="/night" textFill="#777" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label fx:id="descriptionLabel" maxWidth="350.0" text="Description of the room goes here..." textFill="#555" wrapText="true" />

                <FlowPane fx:id="amenitiesBox" hgap="5.0" prefHeight="40.0" vgap="5.0" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </FlowPane>

                <HBox alignment="BOTTOM_RIGHT">
                    <children>
                        <Button fx:id="bookNowBtn" onAction="#onBookNow" mnemonicParsing="false" styleClass="btn-teal" text="Book Now" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>